+// EXPERIMENTAL (exp/pcf-attack). Finite envelope attack time in milliseconds.
+// Default 0 reproduces the shipped INSTANT attack byte for byte. When > 0 the
+// envelope slews up toward a decaying target over this time constant, so on a
+// big sweep the cutoff rises to an IN-BAND peak (rounded, undershooting the
+// clamp) at ~this many ms instead of snapping open above the source. Measured
+// target: ReBirth's chirp brightness peaks at ~52 ms (renders/pcf-chirp).
+static float pcfAttackMs() {
+    static const float v = []{ const char* e = std::getenv("REBORN_PCF_ATK");
+                               return e ? static_cast<float>(std::atof(e)) : 0.0f; }();
+    return v;
+}
+
+// EXPERIMENTAL (exp/pcf-attack). Envelope-excursion SATURATION. Default off is
+// the shipped hard clamp of (cut + envelope), which rails cparam to 1.0 => fc
+// 14.5 kHz on a big sweep, so the cutoff over-opens ABOVE the source and wastes
+// the bright in-band phase (measured: our chirp brightness peaks ~200 ms late
+// where ReBirth's peaks at ~52 ms; renders/pcf-chirp). When on, only the
+// ENVELOPE excursion is saturated, and only within the headroom above the static
+// cutoff: cparam = cut + h*tanh(exc/h), h = 1 - cut. Two properties matter. With
+// exc = 0 (static, Amt 0) cparam is exactly the measured static cutoff, so static
+// parity is untouched. At small excursion the slope is 1, so the measured
+// small-Amt response is untouched too; only a large, over-opening excursion bends,
+// landing the swept peak in-band the way ReBirth's does. No free knob.
+static bool pcfSat() {
+    static const bool v = []{ const char* e = std::getenv("REBORN_PCF_SAT");
+                              return e && std::atof(e) != 0.0; }();
+    return v;
+}
+
+// EXPERIMENTAL (exp/pcf-attack). Cutoff-law CEILING in Hz. Default 0 is off (the
+// shipped extrapolated top of ~14.5 kHz at cparam 1.0). The map fc =
+// 9.01*2^(cparam*10.65) is only measured to ~8 kHz; the drone cannot resolve a
+// cutoff above the source, so everything above kFmaxKneeHz is extrapolation.
+// When set, the cutoff-sum is NOT clamped to 1.0; instead, above the 8 kHz knee
+// the log-frequency saturates toward log2(fmax), so BOTH the static maximum and
+// an envelope-driven over-open cap at fmax. A big sweep then peaks in-band
+// (bright immediately) instead of railing to 14.5 kHz, which is ReBirth's swept
+// behaviour, while every MEASURED static cutoff (<= 8 kHz) is left untouched.
+static float pcfFmax() {
+    static const float v = []{ const char* e = std::getenv("REBORN_PCF_FMAX");
+                               return e ? static_cast<float>(std::atof(e)) : 0.0f; }();
+    return v;
+}
+static inline float cparamMap(float cutBase, float exc, bool sat) {
+    if (!sat) return clampf(cutBase + exc, 0.0f, 1.0f);   // shipped hard clamp
+    const float cb = clampf(cutBase, 0.0f, 1.0f);
+    if (exc <= 0.0f) return clampf(cb + exc, 0.0f, 1.0f);
+    const float h = 1.0f - cb;
+    if (h <= 1e-6f) return 1.0f;
+    return cb + h * std::tanh(exc / h);
+}
